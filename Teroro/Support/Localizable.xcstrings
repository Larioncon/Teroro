    "security_delete_warning_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen Ihres Accounts führt zur vollständigen und unwiderruflichen Löschung aller Ihrer Daten, einschließlich gespeicherter Termine, Profil und Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account will permanently destroy all your data, including saved terms, profile, and settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление аккаунта приведет к полному и безвозвратному уничтожению всех ваших данных, включая сохраненные термины, профиль и настройки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення акаунту призведе до повного та безповоротного знищення всіх ваших даних, включаючи збережені терміни, профіль та налаштування."
          }
        }
      }
    },
